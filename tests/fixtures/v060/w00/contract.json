    "candidate": {
      "description": "精确候选。身份是 head、base、merge、tree，缺一不可。",
      "states": [
        "REGISTERED",
        "SUPERSEDED",
        "INVALID",
        "INTEGRATED"
      ],
      "terminal": [
        "SUPERSEDED",
        "INVALID",
        "INTEGRATED"
      ],
      "required_identity": [
        "head",
        "base",
        "merge",
        "tree"
      ],
      "transitions": [
