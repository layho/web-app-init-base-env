        "feedback_sync",
        "claim",
        "develop",
        "review",
        "test",
        "integrate",
        "preview_merge",
        "deploy",
        "accept",
        "publish",
        "close"
      ],
      "execution_states": [
        "READY",
        "RUNNING",
        "SUCCEEDED",
        "FAILED",
        "RETRY_WAIT",
        "BLOCKED",
        "UNKNOWN",
        "SUPERSEDED",
        "CANCELLED"
      ],
      "terminal_phases": [
        "close"
      ],
      "terminal_execution": [
        "SUCCEEDED",
        "FAILED",
        "SUPERSEDED",
        "CANCELLED"
      ],
      "transitions": [
        {
          "from": "feedback_sync",
          "to": "claim"
        },
        {
          "from": "claim",
          "to": "develop"
        },
        {
          "from": "develop",
          "to": "review"
        },
        {
          "from": "review",
          "to": "test"
        },
        {
          "from": "test",
          "to": "integrate"
        },
        {
          "from": "integrate",
          "to": "preview_merge"
        },
        {
          "from": "preview_merge",
          "to": "deploy"
        },
        {
          "from": "deploy",
          "to": "accept"
        },
        {
          "from": "accept",
          "to": "publish"
        },
        {
          "from": "publish",
          "to": "close"
        },
        {
          "from": "accept",
          "to": "develop",
          "guard": "repair_authorized"
        }
      ]
    },
    "run": {
      "description": "某一阶段的一次执行轮次。旧 run 只读，不能覆盖当前轮次。",
      "states": [
        "PENDING",
